<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0F141C">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ AVYGRAM"
        android:textColor="#00D2FF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telegram hisobingizga kiring"
        android:textColor="#8899A6"
        android:textSize="15sp"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="+998901234567"
        android:textColorHint="#556677"
        android:textColor="#FFFFFF"
        android:inputType="phone"
        android:padding="12dp"
        android:background="#1B2430"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etCode"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Telegram kodi"
        android:textColorHint="#556677"
        android:textColor="#FFFFFF"
        android:inputType="number"
        android:padding="12dp"
        android:background="#1B2430"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Kodni olish"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0088CC"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

</LinearLayout>
